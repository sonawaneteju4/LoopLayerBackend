# ==============================================================================
# LOOPLAYER DESIGNS BACKEND CONFIGURATION
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=9000

# Client Application URLs (CORS allowed origins)
CLIENT_URL=https://looplayerdesing.com
ALLOWED_ORIGINS=https://looplayerdesing.com,https://www.looplayerdesing.com,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE: MongoDB Atlas
# ------------------------------------------------------------------------------
# Replace with your MongoDB Atlas connection URI string:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/looplayer_designs

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Long, cryptographically secure string (e.g. openssl rand -base64 64)
JWT_SECRET=sakdkknaskjka
JWT_EXPIRES_IN=24h

# Secret required to execute the one-time admin account creation endpoint (/api/auth/setup-admin)
ADMIN_SETUP_SECRET=akskknkasnkdankjsndkanksd

# ------------------------------------------------------------------------------
# CLOUDINARY FILE STORAGE
# ------------------------------------------------------------------------------
# Retrieve from your Cloudinary Dashboard (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=looplayer/quotes

# ------------------------------------------------------------------------------
# ZOHO MAIL SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Zoho SMTP Server:
# smtp.zoho.com (or smtppro.zoho.com for Zoho Workplace / organization accounts)
# Port: 465 (SSL, SMTP_SECURE=true) OR 587 (TLS, SMTP_SECURE=false)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@looplayerdesing.com
# For 2FA-enabled accounts, generate an App Password in Zoho Accounts -> Security -> App Passwords
SMTP_PASS=your_zoho_app_password_or_mailbox_password
FROM_NAME="LoopLayer Designs"
FROM_EMAIL=orders@looplayerdesing.com
SMTP_FROM="LoopLayer Designs" <orders@looplayerdesing.com>

# Target email to receive incoming quote and contact notification alerts
ADMIN_NOTIFICATION_EMAIL=orders@looplayerdesing.com

# ------------------------------------------------------------------------------
# FILE UPLOAD LIMITS
# ------------------------------------------------------------------------------
# Maximum file size per file (in megabytes)
MAX_FILE_SIZE_MB=20
# Maximum total files per quote request
MAX_FILE_COUNT=10

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_PUBLIC_MAX=10
RATE_LIMIT_AUTH_MAX=5

