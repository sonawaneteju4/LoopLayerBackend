[https://betterstack.com/ahoy/messages/nOwtT3BHCHP6gvq8n8JDt0llCC3mz9Rc/click?signature=2ac3a60c2bb4c8c73dfdd1c44950db9085bbc627&url=https%3A%2F%2Fbetterstack.com%2Fcommunity%2Fguides%2Fincident-management%2Fon-call-scheduling%2F%3Futm_source%3Dintro%252Fonboarding_drip_journey%26utm_medium%3Demail%26utm_campaign%3Dreliability_on_call_reminder],
